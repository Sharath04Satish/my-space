# Copy to .env (gitignored). Loaded by `npm run photos*` and by Astro.

# Where the browser loads photos from.
#   Local dev:   /img                      (served from .cache/images via public/img)
#   Production:  https://img.example.com   (your R2 bucket's public URL / custom domain)
# Leave unset to see placeholder art.
PUBLIC_IMAGE_BASE=/img

# --- R2 upload (npm run photos:upload) ---
# Create an API token in Cloudflare: R2 > Manage API tokens > Object Read & Write, scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
