---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  /** Top-level section of the site (the main nav) */
  active?: "photography" | "about";
  /** Tab inside the Photography section */
  sub?: "highlights" | "collections" | "gear";
}
const { title, description = "Sharath Satish", active, sub } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <noscript><style>.ph img{opacity:1}</style></noscript>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">Sharath Satish</a>
      <nav>
        <a href="/photography" class={active === "photography" ? "on" : ""}>Photography</a>
        <a href="/about" class={active === "about" ? "on" : ""}>About</a>
      </nav>
    </header>
    {active === "photography" && (
      <nav class="subnav" aria-label="Photography">
        <a href="/photography" class={sub === "highlights" ? "on" : ""}>Highlights</a>
        <a href="/photography/collections" class={sub === "collections" ? "on" : ""}>Collections</a>
        <a href="/photography/gear" class={sub === "gear" ? "on" : ""}>Gear</a>
      </nav>
    )}
    <!-- grows to fill the screen, which keeps the footer at the bottom even on short pages -->
    <div class="page"><slot /></div>
    <footer>
      <span>© {new Date().getFullYear()} Sharath Satish</span>
    </footer>
  </body>
</html>
