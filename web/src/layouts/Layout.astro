---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  active?: "highlights" | "collections" | "about";
}
const { title, description = "Photography portfolio", active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">Sharath Satish</a>
      <nav>
        <a href="/" class={active === "highlights" ? "on" : ""}>Highlights</a>
        <a href="/collections" class={active === "collections" ? "on" : ""}>Collections</a>
        <a href="/about" class={active === "about" ? "on" : ""}>About</a>
      </nav>
    </header>
    <slot />
    <footer>
      <span>© {new Date().getFullYear()} Sharath Satish</span>
    </footer>
  </body>
</html>
